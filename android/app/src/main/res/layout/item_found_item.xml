<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:minHeight="96dp" android:orientation="horizontal" android:padding="8dp">
    <ImageView android:id="@+id/itemImage" android:layout_width="76dp" android:layout_height="76dp"
               android:scaleType="centerCrop" android:contentDescription="@string/object_photo" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                  android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="0dp">
        <TextView android:id="@+id/itemTitleText" style="@style/ListItemTitle" />
        <TextView android:id="@+id/itemCategoryText" style="@style/ListItemText" />
        <TextView android:id="@+id/itemLocationText" style="@style/ListItemText" />
        <TextView android:id="@+id/itemDateText" style="@style/ListItemText" />
    </LinearLayout>
</LinearLayout>
